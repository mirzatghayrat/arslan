      "uri": "arslan://pair?",
      "now": 1790985660,
      "expect_error": "pairing_invalid"
    },
    {
      "name": "issued-in-the-future",
      "uri": "arslan://pair?",
      "now": 1790985660,
      "expect_error": "pairing_invalid"
    },
    {
      "name": "wrong-container",
      "uri": "arslan://pair?",
      "now": 1790985660,
      "expect_error": "wrong_container"
    },
    {
      "name": "wrong-zone",
      "uri": "arslan://pair?",
      "now": 1790985660,
      "expect_error": "malformed"
    },
    {
      "name": "short-key",
      "uri": "arslan://pair?",
      "now": 1790985660,
      "expect_error": "malformed"
    },
    {
      "name": "version-2",
      "uri": "arslan://pair?",
      "now": 1790985660,
      "expect_error": "unsupported_version"
