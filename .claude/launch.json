{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server (FastAPI/uvicorn)",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["server.main:app", "--port", "8741", "--reload"],
      "port": 8741
    },
    {
      "name": "web (Vite/React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--host", "127.0.0.1"],
      "port": 5173,
      "autoPort": false
    }
  ]
}
