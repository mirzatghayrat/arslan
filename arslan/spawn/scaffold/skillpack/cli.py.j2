"""{{ name }} — skill-pack CLI (generated by Arslan).

Credential resolution priority: --api_key flag > .env file > environment.
The `run` command is a placeholder; real tool logic is wired during
capability assignment (Tier-2 evolution), never minted by the spawn itself.
"""
import argparse
import os
import sys
from pathlib import Path


def resolve_credential(cli_value, env_name):
    """3-tier resolution: CLI flag > .env file > environment variable."""
    if cli_value:
        return cli_value
    env_file = Path(__file__).resolve().parent.parent / ".env"
    if env_file.exists():
        for line in env_file.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith(env_name + "="):
                return line.split("=", 1)[1].strip()
    return os.environ.get(env_name)


DOC = """{{ name }} — usage:
  {{ slug }}_cli.py doc              show this help
  {{ slug }}_cli.py run "<input>"    run the skill
"""


def main(argv=None):
    parser = argparse.ArgumentParser(prog="{{ slug }}_cli.py", add_help=False)
    parser.add_argument("command", nargs="?", default="doc")
    parser.add_argument("input", nargs="?", default="")
    parser.add_argument("--api_key", default=None)
    args, _ = parser.parse_known_args(argv)

    if args.command == "doc":
        print(DOC)
        return 0
    if args.command == "run":
        print("[{{ name }}] received: " + args.input)
        return 0
    sys.stderr.write("unknown command: " + str(args.command) + "\n")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
