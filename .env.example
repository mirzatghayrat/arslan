# Deployment mode: dev (default) or prod. In prod a missing ARSLAN_SECRET_KEY
# is boot-fatal. Release artifacts (Dockerfile/compose) pin this to prod.
ARSLAN_ENV=dev

# Optional bearer token protecting the API + WebSocket. Leave blank to disable auth (local only).
ARSLAN_API_TOKEN=

# Secret used to derive the encryption key for stored LLM API keys. Set a long random value in production.
ARSLAN_SECRET_KEY=

# Advisory default bind host for launch scripts. The real bind is the launcher's `uvicorn --host`.
ARSLAN_BIND_HOST=127.0.0.1
