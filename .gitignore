__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
# no trailing slash: it would match DIRECTORIES ONLY, so a .venv SYMLINK (common when
# a git worktree borrows the main checkout's environment) slips past and gets committed.
# web/node_modules was committed exactly that way once.
.venv
venv/
env/
dist/
build/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
*.log
.env
.env.*
!.env.example
spawns/*/
!spawns/.gitkeep

# secrets / key material — never commit
*.pem
*.key
*.p12
credentials*.json

# Local runtime data (SQLite DB + generated spawns) — anchored to repo root so
# source dirs like web/src/data/ are NOT ignored.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# internal research records — design specs, plans, evidence, architecture notes.
# Not published with the open-source release; ignored so a local copy never lands
# in a commit. No trailing slash, per the .venv lesson above: a trailing slash
# matches DIRECTORIES ONLY, so a symlink of the same name slips past.
.superpowers
.omm
docs/superpowers

# PyInstaller output for the desktop sidecar (packaging/arslan-server.spec)
packaging/dist/
packaging/build/

# Tauri build artefacts (the sidecar is staged here by build_dmg.sh)
desktop/src-tauri/target/
desktop/src-tauri/binaries/
desktop/node_modules/
